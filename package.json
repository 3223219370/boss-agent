{
  "name": "boss-agent",
  "displayName": "Boss Agent",
  "version": "0.0.2",
  "description": "BOSS 直聘岗位 AI 匹配分析助手：自动循环分析岗位列表，本地大模型判断匹配度，匹配则生成打招呼语",
  "author": "HXH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3223219370/boss-agent.git"
  },
  "homepage": "https://github.com/3223219370/boss-agent#readme",
  "bugs": {
    "url": "https://github.com/3223219370/boss-agent/issues"
  },
  "keywords": [
    "chrome-extension",
    "boss-zhipin",
    "job-search",
    "ai",
    "llm",
    "ollama",
    "plasmo"
  ],
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build && node scripts/rename-output.mjs",
    "package": "plasmo build && plasmo package && node scripts/rename-output.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "antd": "^6.6.1",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^4.10.38",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "sass": "^1.103.1",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "storage"
    ],
    "host_permissions": [
      "http://localhost:11434/*"
    ]
  }
}
